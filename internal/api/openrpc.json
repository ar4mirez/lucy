                    "type": "string"
                  },
                  "project": {
                    "description": "The target's project.",
                    "type": "string"
                  },
                  "reason": {
                    "description": "Why, in one line. {owner} stands for the owner; render it with the configured display title.",
                    "type": "string"
                  },
                  "resource": {
                    "description": "The target resource.",
                    "type": "string"
                  },
                  "role": {
                    "description": "The actor's role.",
                    "type": "string"
                  },
                  "rule": {
                    "description": "The rule that decided.",
                    "type": "string"
                  },
                  "ruleset_sha256": {
                    "description": "The SHA-256 of that rule set.",
                    "type": "string"
                  },
                  "ruleset_version": {
                    "description": "The version of the rule set that decided.",
                    "type": "integer"
                  },
                  "seq": {
                    "description": "The decision event's position in the whole log.",
                    "type": "integer"
                  },
                  "tainted": {
                    "description": "Whether any input came from an untrusted source.",
                    "type": "boolean"
                  },
                  "time": {
                    "description": "When it was recorded, UTC.",
                    "format": "date-time",
