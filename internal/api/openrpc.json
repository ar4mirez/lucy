                  },
                  "facts_sha256": {
                    "description": "The digest of the facts the approver saw (a merge's head SHA, base ref and base SHA; a delete's resolved path; a credential's scope; the default branch for force-push, branch delete and history rewrite) an approval must also name; an approval for the same action under other facts is denied.",
                    "type": "string"
                  },
                  "id": {
                    "description": "The decision's position in the policy stream; pass as after to page.",
                    "type": "integer"
                  },
                  "kind": {
                    "description": "The action.",
                    "type": "string"
                  },
                  "org": {
