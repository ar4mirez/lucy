                  }
                },
                "required": [
                  "seq",
                  "id",
                  "time",
                  "outcome",
                  "rule",
                  "reason",
                  "ruleset_version",
                  "ruleset_sha256",
                  "action_sha256",
                  "facts_sha256",
                  "tainted",
