                      "type": "object"
                    },
                    "type": "array"
                  },
                  "kind": {
                    "description": "The resource kind.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The resource's name, unique per namespace and kind.",
                    "type": "string"
                  },
                  "namespace": {
                    "description": "The airspace (org) the resource belongs to.",
