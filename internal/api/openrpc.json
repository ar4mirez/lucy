{
  "openrpc": "1.3.2",
  "info": {
    "title": "lucy API",
    "description": "One typed API behind every lucy surface: JSON-RPC 2.0, one request per POST to /rpc/v1, over the daemon's unix socket (and HTTPS for remote surfaces, from m1). See ADR D10.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "name": "local",
      "url": "unix:$XDG_RUNTIME_DIR/lucy/lucy.sock/rpc/v1"
    }
  ],
  "methods": [
    {
      "name": "rpc.discover",
      "summary": "The API's OpenRPC document: every method, its params, result and errors.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "description": "An OpenRPC document (this one).",
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    },
    {
      "name": "hello",
      "summary": "Negotiate the API version and learn the caller's identity, scopes and the methods it may call.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "client",
          "description": "The calling surface, for example lucy-cli.",
          "required": true,
          "schema": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "client_version",
          "description": "The calling surface's version.",
          "required": false,
          "schema": {
            "maxLength": 64,
            "type": "string"
          }
        },
        {
          "name": "api_versions",
          "description": "API major versions the client speaks.",
          "required": true,
          "schema": {
            "items": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          }
        }
      ],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "api_version": {
              "description": "The API version chosen: the highest both sides speak.",
              "type": "integer"
            },
            "caller": {
              "description": "Who the daemon thinks is calling.",
              "properties": {
                "actor": {
                  "description": "The caller's name in the event log.",
                  "type": "string"
                },
                "device": {
                  "description": "local for the socket; a paired device's id remotely.",
                  "type": "string"
                },
                "pid": {
                  "description": "The peer's process id, when the OS reports it.",
                  "type": "integer"
                },
                "scopes": {
                  "description": "The scopes granted to this caller.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "transport": {
                  "description": "unix, or https once remote control lands.",
                  "type": "string"
                },
                "uid": {
                  "description": "The peer's user id on the unix socket.",
                  "type": "integer"
                }
              },
              "required": [
                "actor",
                "transport",
                "uid",
                "device",
                "scopes"
              ],
              "type": "object"
            },
            "methods": {
              "description": "The methods this caller's scopes allow.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "server_version": {
              "description": "The daemon's lucy version.",
              "type": "string"
            }
          },
          "required": [
            "api_version",
            "server_version",
            "caller",
            "methods"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "hello"
    },
    {
      "name": "health",
      "summary": "Liveness: the daemon is up and its event store answers.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "status": {
              "description": "ok when the daemon and its event store answer.",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    },
    {
      "name": "status.get",
      "summary": "The daemon's version, uptime and event log head.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "api_version": {
              "description": "The API version served.",
              "type": "integer"
            },
            "event_head": {
              "description": "Sequence number of the last event in the log; 0 when empty.",
              "type": "integer"
            },
            "pid": {
              "description": "The daemon's process id.",
              "type": "integer"
            },
            "refused_connections": {
              "description": "Socket connections refused since start (another user, or no peer credentials).",
              "type": "integer"
            },
            "server_version": {
              "description": "The daemon's lucy version.",
              "type": "string"
            },
            "started_at": {
              "description": "When the daemon started, UTC.",
              "format": "date-time",
              "type": "string"
            },
            "uptime_seconds": {
              "description": "Seconds since the daemon started.",
              "type": "integer"
            }
          },
          "required": [
            "server_version",
            "api_version",
            "pid",
            "started_at",
            "uptime_seconds",
            "event_head",
            "refused_connections"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    },
    {
      "name": "events.list",
      "summary": "Events from the log after a sequence number, oldest first.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "after_seq",
          "description": "Return events with a sequence number greater than this; 0 starts at the beginning.",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "name": "limit",
          "description": "At most this many events; 0 means 100.",
          "required": false,
          "schema": {
            "maximum": 500,
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "events": {
              "description": "The events, oldest first.",
              "items": {
                "properties": {
                  "actor": {
                    "description": "Who caused it.",
                    "type": "string"
                  },
                  "payload": {
                    "description": "The typed payload as stored; events never carry secrets."
                  },
                  "seq": {
                    "description": "Position in the whole log.",
                    "type": "integer"
                  },
                  "stream": {
                    "description": "The stream the event belongs to.",
                    "type": "string"
                  },
                  "stream_version": {
                    "description": "Position in its stream.",
                    "type": "integer"
                  },
                  "time": {
                    "description": "When it was appended, UTC.",
                    "format": "date-time",
                    "type": "string"
                  },
                  "type": {
                    "description": "Event type name.",
                    "type": "string"
                  },
                  "type_version": {
                    "description": "Version of the payload schema.",
                    "type": "integer"
                  }
                },
                "required": [
                  "seq",
                  "stream",
                  "stream_version",
                  "type",
                  "type_version",
                  "time",
                  "actor",
                  "payload"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "head": {
              "description": "The log's head when the page was read.",
              "type": "integer"
            },
            "more": {
              "description": "Whether events after this page existed when it was read.",
              "type": "boolean"
            },
            "next": {
              "description": "Pass as after_seq to read the next page.",
              "type": "integer"
            }
          },
          "required": [
            "events",
            "head",
            "next",
            "more"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    },
    {
      "name": "daemon.shutdown",
      "summary": "Stop the daemon gracefully after answering.",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "stopping": {
              "description": "True: the daemon stops after this response.",
              "type": "boolean"
            }
          },
          "required": [
            "stopping"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "admin",
      "x-lucy-mutating": true,
      "x-lucy-group": "command"
    },
    {
      "name": "policy.evaluate",
      "summary": "Ask the policy engine to decide an action; the decision is recorded before it is returned.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "kind",
          "description": "The action: read, write, merge, delete, force_push, branch_delete, history_rewrite or credential_use.",
          "required": true,
          "schema": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "org",
          "description": "The org the target belongs to.",
          "required": true,
          "schema": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "project",
          "description": "The project (repository), when the action has one.",
          "required": false,
          "schema": {
            "maxLength": 128,
            "type": "string"
          }
        },
        {
          "name": "resource",
          "description": "What the action is on: a PR (pr/12), an absolute path, a branch or a credential name.",
          "required": false,
          "schema": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        {
          "name": "inputs",
          "description": "What the request is based on, each with its source. The caller's own request is added as a captain input.",
          "required": false,
          "schema": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "description": "A reference to the input: an event, URL or comment id. Never the text itself.",
                  "maxLength": 128,
                  "type": "string"
                },
                "source": {
                  "description": "captain, config, daemon, task, agent, tool_output, repo_content, issue, pr_body, pr_comment, web or email.",
                  "maxLength": 32,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "maxItems": 31,
            "type": "array"
          }
        }
      ],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "action_sha256": {
              "description": "The digest of the action (actor, kind, target) an approval must name.",
              "type": "string"
            },
            "actor": {
              "description": "Who asked.",
              "type": "string"
            },
            "approval": {
              "description": "The approval decision that allowed it, if any.",
              "type": "string"
            },
            "id": {
              "description": "The decision's position in the policy stream; pass as after to page.",
              "type": "integer"
            },
            "kind": {
              "description": "The action.",
              "type": "string"
            },
            "org": {
              "description": "The target's org.",
              "type": "string"
            },
            "outcome": {
              "description": "allow, deny or require-captain.",
              "type": "string"
            },
            "project": {
              "description": "The target's project.",
              "type": "string"
            },
            "reason": {
              "description": "Why, in one line.",
              "type": "string"
            },
            "resource": {
              "description": "The target resource.",
              "type": "string"
            },
            "role": {
              "description": "The actor's role.",
              "type": "string"
            },
            "rule": {
              "description": "The rule that decided.",
              "type": "string"
            },
            "ruleset_sha256": {
              "description": "The SHA-256 of that rule set.",
              "type": "string"
            },
            "ruleset_version": {
              "description": "The version of the rule set that decided.",
              "type": "integer"
            },
            "seq": {
              "description": "The decision event's position in the whole log.",
              "type": "integer"
            },
            "tainted": {
              "description": "Whether any input came from an untrusted source.",
              "type": "boolean"
            },
            "time": {
              "description": "When it was recorded, UTC.",
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "seq",
            "id",
            "time",
            "outcome",
            "rule",
            "reason",
            "ruleset_version",
            "ruleset_sha256",
            "action_sha256",
            "tainted",
            "actor",
            "role",
            "kind",
            "org"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "decide",
      "x-lucy-mutating": true,
      "x-lucy-group": "command"
    },
    {
      "name": "policy.decisions",
      "summary": "Recorded policy decisions, oldest first.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "after",
          "description": "Return decisions with an id greater than this; 0 starts at the beginning.",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "name": "limit",
          "description": "At most this many decisions; 0 means 100.",
          "required": false,
          "schema": {
            "maximum": 500,
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "decisions": {
              "description": "The decisions, oldest first.",
              "items": {
                "properties": {
                  "action_sha256": {
                    "description": "The digest of the action (actor, kind, target) an approval must name.",
                    "type": "string"
                  },
                  "actor": {
                    "description": "Who asked.",
                    "type": "string"
                  },
                  "approval": {
                    "description": "The approval decision that allowed it, if any.",
                    "type": "string"
                  },
                  "id": {
                    "description": "The decision's position in the policy stream; pass as after to page.",
                    "type": "integer"
                  },
                  "kind": {
                    "description": "The action.",
                    "type": "string"
                  },
                  "org": {
                    "description": "The target's org.",
                    "type": "string"
                  },
                  "outcome": {
                    "description": "allow, deny or require-captain.",
                    "type": "string"
                  },
                  "project": {
                    "description": "The target's project.",
                    "type": "string"
                  },
                  "reason": {
                    "description": "Why, in one line.",
                    "type": "string"
                  },
                  "resource": {
                    "description": "The target resource.",
                    "type": "string"
                  },
                  "role": {
                    "description": "The actor's role.",
                    "type": "string"
                  },
                  "rule": {
                    "description": "The rule that decided.",
                    "type": "string"
                  },
                  "ruleset_sha256": {
                    "description": "The SHA-256 of that rule set.",
                    "type": "string"
                  },
                  "ruleset_version": {
                    "description": "The version of the rule set that decided.",
                    "type": "integer"
                  },
                  "seq": {
                    "description": "The decision event's position in the whole log.",
                    "type": "integer"
                  },
                  "tainted": {
                    "description": "Whether any input came from an untrusted source.",
                    "type": "boolean"
                  },
                  "time": {
                    "description": "When it was recorded, UTC.",
                    "format": "date-time",
                    "type": "string"
                  }
                },
                "required": [
                  "seq",
                  "id",
                  "time",
                  "outcome",
                  "rule",
                  "reason",
                  "ruleset_version",
                  "ruleset_sha256",
                  "action_sha256",
                  "tainted",
                  "actor",
                  "role",
                  "kind",
                  "org"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "more": {
              "description": "Whether decisions after this page existed when it was read.",
              "type": "boolean"
            },
            "next": {
              "description": "Pass as after to read the next page.",
              "type": "integer"
            }
          },
          "required": [
            "decisions",
            "next",
            "more"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    }
  ],
  "components": {
    "errors": {
      "forbidden": {
        "code": -32001,
        "message": "forbidden"
      },
      "internal": {
        "code": -32603,
        "message": "internal error"
      },
      "invalid_params": {
        "code": -32602,
        "message": "invalid params"
      },
      "invalid_request": {
        "code": -32600,
        "message": "invalid request"
      },
      "method_not_found": {
        "code": -32601,
        "message": "method not found"
      },
      "parse_error": {
        "code": -32700,
        "message": "parse error"
      },
      "timeout": {
        "code": -32005,
        "message": "deadline exceeded"
      },
      "too_large": {
        "code": -32003,
        "message": "request too large"
      },
      "unavailable": {
        "code": -32004,
        "message": "daemon unavailable"
      },
      "unsupported_version": {
        "code": -32002,
        "message": "unsupported API version"
      }
    },
    "schemas": {
      "ErrorData": {
        "properties": {
          "field": {
            "description": "The params field (or request member) at fault.",
            "type": "string"
          },
          "help": {
            "description": "What to change in the request.",
            "type": "string"
          },
          "kind": {
            "description": "Stable name of the error code, for example invalid_params.",
            "type": "string"
          },
          "request_id": {
            "description": "Correlation id for an internal error; the daemon's log has the details.",
            "type": "string"
          },
          "supported": {
            "description": "API versions the daemon serves (unsupported_version).",
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      }
    }
  }
}
