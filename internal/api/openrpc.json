                ],
                "type": "object"
              },
              "type": "array"
            },
            "more": {
              "description": "Whether decisions after this page existed when it was read.",
              "type": "boolean"
            },
            "next": {
              "description": "Pass as after to read the next page.",
              "type": "integer"
            }
          },
          "required": [
            "decisions",
            "next",
            "more"
          ],
          "type": "object"
        }
      },
      "x-lucy-scope": "read",
      "x-lucy-mutating": false,
      "x-lucy-group": "query"
    },
    {
      "name": "resources.list",
      "summary": "The config resources the daemon loaded and their status, as conditions.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "offset",
          "description": "Skip this many resources; 0 starts at the beginning.",
          "required": false,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "name": "limit",
          "description": "At most this many resources; 0 means 100.",
          "required": false,
          "schema": {
            "maximum": 500,
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "result",
        "required": true,
        "schema": {
          "properties": {
            "more": {
              "description": "Whether resources after this page existed when it was read.",
              "type": "boolean"
            },
            "next": {
              "description": "Pass as offset to read the next page.",
              "type": "integer"
            },
            "refused": {
              "description": "Files and documents the latest load refused that name no resource: a parse error, a missing or invalid kind, name or namespace, or a duplicate. On the first page (offset 0) only; empty on the others.",
              "items": {
                "properties": {
                  "conditions": {
                    "description": "Its status, as conditions.",
                    "items": {
                      "properties": {
                        "last_transition_time": {
                          "description": "When the status last changed, RFC 3339 UTC.",
                          "type": "string"
                        },
                        "message": {
                          "description": "What a person needs to know.",
                          "type": "string"
                        },
                        "reason": {
                          "description": "A machine-readable reason, for example SchemaViolation.",
                          "type": "string"
                        },
                        "status": {
                          "description": "True, False or Unknown.",
                          "type": "string"
                        },
                        "type": {
                          "description": "The aspect, for example Valid.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "status"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "reason": {
                    "description": "Why it was refused, the Valid condition's reason, for example MissingNamespace.",
                    "type": "string"
                  },
                  "source": {
                    "description": "The file it came from, relative to the config directory, and the document's position in it.",
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "reason",
                  "conditions"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "refused_truncated": {
              "description": "Refusals the latest load left out of refused, beyond the 32 it records.",
              "type": "integer"
            },
            "resources": {
              "description": "The resources and their current status.",
              "items": {
                "properties": {
                  "api_version": {
                    "description": "The apiVersion the file declares.",
                    "type": "string"
                  },
                  "conditions": {
                    "description": "The resource's status, as conditions.",
                    "items": {
                      "properties": {
                        "last_transition_time": {
                          "description": "When the status last changed, RFC 3339 UTC.",
                          "type": "string"
                        },
                        "message": {
                          "description": "What a person needs to know.",
                          "type": "string"
                        },
                        "reason": {
                          "description": "A machine-readable reason, for example SchemaViolation.",
                          "type": "string"
                        },
                        "status": {
                          "description": "True, False or Unknown.",
                          "type": "string"
                        },
                        "type": {
                          "description": "The aspect, for example Valid.",
                          "type": "string"
                        }
                      },
                      "required": [
