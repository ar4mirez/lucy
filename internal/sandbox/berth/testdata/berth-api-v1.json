{
  "openapi": "3.1.0",
  "info": {
    "title": "berth",
    "version": "v1"
  },
  "x-lucy-excerpt": "The operations of berth API v1 that lucy uses, copied unchanged from berth docs/api/openapi.json at commit d527c10; refresh it with the berth version lucy pins.",
  "paths": {
    "/v1": {
      "get": {
        "operationId": "api_info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "admin": {
                      "type": "boolean"
                    },
                    "read_only": {
                      "type": "boolean"
                    },
                    "restarts": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "writes": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "schema",
                    "version",
                    "read_only",
                    "writes",
                    "restarts",
                    "admin"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The server."
          }
        },
        "summary": "What is serving, and what this caller may do",
        "x-berth-access": "read"
      }
    },
    "/v1/orgs/{org}": {
      "get": {
        "description": "An org's connection sheet: its state, address and ports, the claude.ai/code link, and its git public key. Never the browser terminal's password.",
        "operationId": "org_info",
        "parameters": [
          {
            "description": "the org, as in acme, or acme@box1 for one on a registered host",
            "in": "path",
            "name": "org",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "address": {
                      "type": "string"
                    },
                    "container": {
                      "type": "string"
                    },
                    "git_public_key": {
                      "type": "string"
                    },
                    "local_only": {
                      "type": "boolean"
                    },
                    "org": {
                      "type": "string"
                    },
                    "remote_url": {
                      "type": "string"
                    },
                    "schema": {
                      "type": "string"
                    },
                    "ssh_host": {
                      "type": "string"
                    },
                    "ssh_port": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "state": {
                      "type": "string"
                    },
                    "ttyd_port": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "tunnel": {
                      "additionalProperties": false,
                      "properties": {
                        "connect": {
                          "type": "string"
                        },
                        "ssh_target": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "connect",
                        "ssh_target"
                      ],
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "user": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema",
                    "org",
                    "container",
                    "state",
                    "remote_url",
                    "address",
                    "local_only",
                    "ssh_port",
                    "ttyd_port",
                    "user",
                    "ssh_host",
                    "git_public_key",
                    "tunnel"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The result."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The arguments don't fit."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No token, or a wrong one (TCP only)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such org, host or endpoint."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The org isn't in a state for this (not running, say)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The operation failed."
          }
        },
        "summary": "An org's connection sheet: its state, address and ports, the claude.ai/code link, and its git public key",
        "x-berth-about": "An org's connection sheet: its state, address and ports, the claude.ai/code link, and its git public key. Never the browser terminal's password.",
        "x-berth-access": "read",
        "x-berth-operation": "info"
      }
    },
    "/v1/orgs/{org}/up": {
      "post": {
        "description": "Start an org: gets its image if needed, then recreates its container. Restarts or stops the org's container, which stops the work running in it: needs the server started with --allow-restarts, and `confirm` set to the org's name.",
        "operationId": "org_up",
        "parameters": [
          {
            "description": "the org, as in acme, or acme@box1 for one on a registered host",
            "in": "path",
            "name": "org",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "confirm": {
                    "description": "the org's name again, exactly as in the path: the confirmation that stopping the work running in it was agreed to",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "image": {
                      "type": "string"
                    },
                    "org": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "org",
                    "output",
                    "image"
                  ],
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "description": "With Accept: text/event-stream: the operation's progress as berth.event/v1 events (start, step, output, then done or failed), then a `result` event with the document.",
                  "type": "string"
                }
              }
            },
            "description": "The result."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The arguments don't fit."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No token, or a wrong one (TCP only)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "This caller may not do this: read-only, a token without the scope, or a restart without `confirm`."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such org, host or endpoint."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The org isn't in a state for this (not running, say)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The operation failed."
          }
        },
        "summary": "Start an org: gets its image if needed, then recreates its container",
        "x-berth-about": "Start an org: gets its image if needed, then recreates its container.",
        "x-berth-access": "restart",
        "x-berth-operation": "up"
      }
    },
