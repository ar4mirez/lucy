{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ar4mirez/lucy/blob/main/internal/spec/schemas/lucy/v1alpha1/pilot.schema.json",
  "title": "lucy Pilot",
  "description": "A worker agent flying one flight. Stub: later slices add fields.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "type": "string", "const": "Pilot" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "enum": ["worker", "researcher", "reviewer"], "description": "The pilot role: ship worker, researcher or reviewer." }
      },
      "additionalProperties": false
    },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  },
  "additionalProperties": false
}
