{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ar4mirez/lucy/blob/main/internal/spec/schemas/lucy/v1alpha1/runway.schema.json",
  "title": "lucy Runway",
  "description": "A project (a repository) inside an airspace. Stub: later slices add fields.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "type": "string", "const": "Runway" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "maxLength": 512, "description": "The repository, for example owner/name on the forge." },
        "defaultBranch": { "type": "string", "maxLength": 255, "default": "main", "description": "The branch changes land on." }
      },
      "additionalProperties": false
    },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  },
  "additionalProperties": false
}
